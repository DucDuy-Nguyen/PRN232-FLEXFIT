{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "AllowedOrigins": [ "http://localhost:5173" ],
    "RequestBodyLimitBytes": 1048576
  },
  "Jwt": {
    "Issuer": "FlexFitIdentity",
    "Audience": "FlexFitClient"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-public-google-login": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "auth-strict",
        "Match": {
          "Path": "/api/v1/auth/google-login"
        }
      },
      "auth-public-register": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "auth-strict",
        "Match": {
          "Path": "/api/v1/auth/register"
        }
      },
      "auth-public-login": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "auth-strict",
        "Match": {
          "Path": "/api/v1/auth/login"
        }
      },
      "auth-public-refresh": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "auth-standard",
        "Match": {
          "Path": "/api/v1/auth/refresh-token"
        }
      },
      "auth-public-verify": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "auth-standard",
        "Match": {
          "Path": "/api/v1/auth/verify-email"
        }
      },
      "auth-public-resend": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "auth-strict",
        "Match": {
          "Path": "/api/v1/auth/resend-otp"
        }
      },
      "auth-public-forgot": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "auth-strict",
        "Match": {
          "Path": "/api/v1/auth/forgot-password"
        }
      },
      "auth-public-reset": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "auth-strict",
        "Match": {
          "Path": "/api/v1/auth/reset-password"
        }
      },
      "auth-protected-logout": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "GatewayAuthenticated",
        "RateLimiterPolicy": "authenticated",
        "Match": {
          "Path": "/api/v1/auth/logout"
        }
      },
      "auth-protected-change-password": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "GatewayAuthenticated",
        "RateLimiterPolicy": "authenticated",
        "Match": {
          "Path": "/api/v1/auth/change-password"
        }
      },
      "users-route": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "GatewayUserManagement",
        "RateLimiterPolicy": "authenticated",
        "Match": {
          "Path": "/api/v1/users/{**catch-all}"
        }
      },
      "profiles-route": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "GatewayAuthenticated",
        "RateLimiterPolicy": "authenticated",
        "Match": {
          "Path": "/api/v1/profiles/{**catch-all}"
        }
      },
      "identity-swagger-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/swagger/identity/swagger.json"
        },
        "Transforms": [
          {
            "PathPattern": "/swagger/v1/swagger.json"
          }
        ]
      },
      "booking-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/api/v1/booking/{**catch-all}"
        }
      },
      "booking-legacy-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/api/bookings/{**catch-all}"
        }
      },
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/v1/catalog/{**catch-all}"
        }
      },
      "catalog-legacy-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/classes/{**catch-all}"
        }
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/v1/payment/{**catch-all}"
        }
      },
      "engagement-route": {
        "ClusterId": "engagement-cluster",
        "Match": {
          "Path": "/api/v1/engagement/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-api": {
            "Address": "http://flexfit-identity:8080"
          }
        }
      },
      "booking-cluster": {
        "Destinations": {
          "booking-api": {
            "Address": "http://flexfit-booking:8080"
          }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "catalog-api": {
            "Address": "http://flexfit-catalog:5002"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "payment-api": {
            "Address": "http://payment-api:8080"
          }
        }
      },
      "engagement-cluster": {
        "Destinations": {
          "engagement-api": {
            "Address": "http://flexfit-engagement:8080"
          }
        }
      }
    }
  }
}
