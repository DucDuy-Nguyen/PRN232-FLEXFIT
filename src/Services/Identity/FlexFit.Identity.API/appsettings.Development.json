{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "IdentityDatabase": "Server=(localdb)\\mssqllocaldb;Database=FlexFitIdentityDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Jwt": {
    "Key": "PlaceholderSecretKeyThatIsAtLeast32BytesLong!",
    "Issuer": "FlexFitIdentity",
    "Audience": "FlexFitClient",
    "ExpiryMinutes": 60
  },
  "Otp": {
    "ExpiryMinutes": 10,
    "ResendCooldownSeconds": 60,
    "MaxAttempts": 5
  },
  "RefreshToken": {
    "ExpiryDays": 7,
    "RotationGracePeriodSeconds": 30
  },
  "LoginSecurity": {
    "MaxFailedAttempts": 5,
    "LockoutDurationMinutes": 15,
    "RateLimitWindowSeconds": 60,
    "MaxRequestsPerWindow": 10
  },
  "Email": {
    "SmtpServer": "localhost",
    "SmtpPort": 25,
    "SenderEmail": "noreply@flexfit.com",
    "SenderName": "FlexFit Support",
    "SmtpUsername": "user",
    "SmtpPassword": "password"
  },
  "GoogleAuthentication": {
    "ClientId": "PLACEHOLDER_SET_VIA_USER_SECRETS"
  }
}
