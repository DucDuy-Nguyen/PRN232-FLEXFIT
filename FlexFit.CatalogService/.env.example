# FlexFit Catalog Service Environment Variables Template
# Copy this file to .env and fill in the values

# Database Connection
CATALOG_DB_CONNECTION_STRING=Server=(localdb)\mssqllocaldb;Database=FlexFitCatalogDb;Trusted_Connection=True;MultipleActiveResultSets=true

# JWT Token Validation
JWT_KEY=FlexFitSuperSecretKeyOfAtLeast32BytesLength!
JWT_ISSUER=FlexFit
JWT_AUDIENCE=FlexFitClients

# Redis Connection
REDIS_CONNECTION_STRING=localhost:6379

# Service Ports Configuration
CATALOG_REST_PORT=5002
CATALOG_GRPC_PORT=5003
